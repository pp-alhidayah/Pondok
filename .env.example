# Backend Fase 3 — Sistem Informasi Pondok Al Hidayah
PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=al_hidayah
CORS_ORIGIN=http://localhost:3000
SESSION_SECRET=changes-me-in-production
SESSION_TTL_HOURS=12

# Frontend (Vite): 'local' = dev stabil pakai localStorage; 'api' = produksi pakai backend
VITE_API_MODE=local
VITE_API_URL=http://localhost:3001

# Catatan: development memakai localStorage (data demo otomatis).
# Production: salin env.production.example → .env.production (VITE_API_MODE=api).
# E2E: salin env.test.example → .env.test (VITE_API_MODE=local).
