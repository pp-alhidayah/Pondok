# Salin ke .env.production sebelum `npm run build`.
# Kosongkan VITE_API_URL bila frontend & API satu domain (API di /api via reverse proxy).
# Jika API di domain lain, isi ORIGIN saja — JANGAN menyertakan /api di sini,
# karena setiap request sudah memakai path /api/...
VITE_API_MODE=api
VITE_API_URL=
