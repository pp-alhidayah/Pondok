
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pondok",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/health",
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pondok-alhidayah",
      "database_id": "5693eb7b-db75-44ed-9bda-7007d9781575"
    }
  ]
}
